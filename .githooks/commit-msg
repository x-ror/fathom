#!/bin/sh
set -eu

msg_file="${1:?commit message file path is required}"
header=""

while IFS= read -r line || [ -n "$line" ]; do
  line=$(printf '%s' "$line" | tr -d '\r')
  case "$line" in
    \#*|"") continue ;;
    *)
      header="$line"
      break
      ;;
  esac
done < "$msg_file"

if [ -z "$header" ]; then
  echo "error: commit message must not be empty." >&2
  exit 1
fi

case "$header" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

pattern='^(feat|fix|perf|refactor|docs|test|build|ci|chore|style)(\([a-z0-9._-]+\))?(!)?: [^[:space:]](.*[^.[:space:]])?$'
if ! printf '%s\n' "$header" | grep -Eq "$pattern"; then
  cat >&2 <<EOF
error: invalid commit message header:
  $header

Expected Conventional Commits format:
  <type>(<scope>): <subject>

Allowed types:
  feat, fix, perf, refactor, docs, test, build, ci, chore, style

Examples:
  feat(utf): add BOM-less UTF-32 detection
  fix(detector): handle NUL-terminated UTF-8 strings
  chore: add commit message conventions
EOF
  exit 1
fi

length=$(printf '%s' "$header" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' ')
if [ "$length" -gt 72 ]; then
  cat >&2 <<EOF
error: commit message header is $length characters (max 72):
  $header
EOF
  exit 1
fi
