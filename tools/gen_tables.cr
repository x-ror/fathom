# Regenerates src/fathom/tables.cr from trained bigram models in tools/models/*.json
# and the system iconv:
#   crystal run tools/gen_tables.cr > src/fathom/tables.cr
# iconv is needed only here; the shard itself decodes nothing through it.
require "json"
require "../src/fathom/encoding"

MODELS_DIR = File.expand_path("models", __DIR__)
MODELS     = %w(western ru uk be)

PROBER_SPECS = [
  {"WINDOWS-1252", "western", false},
  {"WINDOWS-1251", "ru", true},
  {"WINDOWS-1251", "uk", true},
  {"WINDOWS-1251", "be", true},
  {"KOI8-R", "ru", true},
  {"KOI8-U", "uk", true},
  {"ISO-8859-5", "ru", true},
  {"ISO-8859-5", "uk", true},
  {"IBM866", "ru", true},
]

KIND_OTHER = 0_u8
KIND_LOWER = 1_u8
KIND_UPPER = 2_u8
KIND_JUNK  = 3_u8

struct ModelSpec
  getter name : String
  getter alphabet : String
  getter matrix : Array(Int32)
  getter index : Hash(Char, UInt8)

  def initialize(@name : String, @alphabet : String, @matrix : Array(Int32))
    @index = {} of Char => UInt8
    @alphabet.each_char_with_index do |ch, i|
      @index[ch] = (i + 1).to_u8
    end
  end
end

def load_model(name : String) : ModelSpec
  path = File.join(MODELS_DIR, "#{name}.json")
  abort "missing model #{path}; run tools/train_models.cr --fetch first" unless File.exists?(path)
  data = JSON.parse(File.read(path))
  ModelSpec.new(
    data["name"].as_s,
    data["alphabet"].as_s,
    data["matrix"].as_a.map(&.as_i),
  )
end

def byte_entry(byte : Int32, char : Char, model : ModelSpec, requires_high_letters : Bool) : UInt8
  if byte < 0x80
    if (byte < 0x20 && ![0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x1B].includes?(byte)) || byte == 0x7F
      return KIND_JUNK << 6
    end
    if !requires_high_letters
      if order = model.index[char.downcase]?
        kind = char.uppercase? ? KIND_UPPER : KIND_LOWER
        return (kind << 6) | order
      end
    end
    return KIND_OTHER << 6
  end

  if char == '\u{FFFD}' || char.ord < 0xA0 || (0x2500..0x259F).includes?(char.ord)
    return KIND_JUNK << 6
  end

  if order = model.index[char.downcase]?
    kind = char.uppercase? ? KIND_UPPER : KIND_LOWER
    return (kind << 6) | order
  end

  # High letters outside a Cyrillic language's alphabet (e.g. Ukrainian є/і/ї/ґ in Russian)
  # are penalized as Junk; Western accepts occasional non-alphabet Latin characters as Other.
  if requires_high_letters && char.letter?
    return KIND_JUNK << 6
  end

  KIND_OTHER << 6
end

models = {} of String => ModelSpec
MODELS.each { |name| models[name] = load_model(name) }

puts "# Generated by tools/gen_tables.cr. Do not edit."
puts "module Fathom"
puts "  module SingleByte"
puts "    private MODELS = {"
MODELS.each do |name|
  m = models[name]
  puts "      #{name.inspect} => LanguageModel.new("
  puts "        #{name.inspect},"
  puts "        StaticArray["
  m.matrix.each_slice(16) do |slice|
    puts "          #{slice.map { |v| "#{v}_i8" }.join(", ")},"
  end
  puts "        ],"
  puts "      ),"
end
puts "    }"
puts
puts "    # Precomputed single-byte bigram probers (WINDOWS-1252 first to break ties on shared bytes)."
puts "    PROBERS = ["

PROBER_SPECS.each do |enc, model_name, requires_high_letters|
  m = models[model_name]
  iconv_enc = Fathom::Encoding.iconv_name(enc)
  entries = (0..255).map do |b|
    char = if b < 0x80
             b.chr
           else
             String.new(Bytes[b.to_u8], iconv_enc, invalid: :skip)[0]? || '\u{FFFD}'
           end
    byte_entry(b, char, m, requires_high_letters)
  end

  puts "      Table.new("
  puts "        #{enc.inspect},"
  puts "        MODELS[#{model_name.inspect}],"
  puts "        #{requires_high_letters},"
  puts "        StaticArray["
  entries.each_slice(16) do |slice|
    puts "          #{slice.map { |v| "#{v}_u8" }.join(", ")},"
  end
  puts "        ],"
  puts "      ),"
end

puts "    ] of Fathom::Prober"
puts "  end"
puts "end"
