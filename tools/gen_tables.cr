# Regenerates src/fathom/tables.cr from the system iconv:
#   crystal run tools/gen_tables.cr > src/fathom/tables.cr
# iconv is needed only here; the shard itself decodes nothing through it.
ENCODINGS = %w[WINDOWS-1252 WINDOWS-1251 KOI8-R KOI8-U ISO-8859-5 IBM866]

puts "# Generated by tools/gen_tables.cr. Do not edit."
puts "module Fathom"
puts "  # Unicode for bytes 0x80..0xFF of each single-byte encoding; U+FFFD marks an undefined byte."
puts "  TABLES = {"
ENCODINGS.each do |enc|
  escaped = (0x80..0xFF).join do |b|
    char = String.new(Bytes[b.to_u8], enc, invalid: :skip)[0]? || '�'
    "\\u{#{char.ord.to_s(16)}}"
  end
  puts "    #{enc.inspect} => \"#{escaped}\".chars,"
end
puts "  }"
puts "end"
