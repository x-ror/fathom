# Regenerates src/fathom/tables.cr from trained bigram models in tools/models/*.json
# and the system iconv:
#   crystal run tools/gen_tables.cr > src/fathom/tables.cr
# iconv is needed only here; the shard itself decodes nothing through it.
require "json"
require "../src/fathom/encoding"

MODELS_DIR = File.expand_path("models", __DIR__)

# {encoding, model, requires_high_letters}.
# Detection is chardetng's (src/fathom/chardetng.cr); these probers only settle
# near-ties among the Latin Windows/ISO encodings and report Match#language for
# encodings shared by several languages. Encodings whose language is fixed get
# it from Chardetng::Prober#language and need no prober here.
PROBER_SPECS = [
  {"WINDOWS-1252", "western", false},
  {"WINDOWS-1250", "pl", false},
  {"WINDOWS-1250", "cs", false},
  {"WINDOWS-1250", "hu", false},
  {"ISO-8859-2", "pl", false},
  {"ISO-8859-2", "cs", false},
  {"ISO-8859-2", "hu", false},
  {"WINDOWS-1257", "lt", false},
  {"WINDOWS-1257", "lv", false},
  {"ISO-8859-13", "lt", false},
  {"ISO-8859-13", "lv", false},
  {"WINDOWS-1254", "tr", false},
  {"WINDOWS-1251", "ru", true},
  {"WINDOWS-1251", "uk", true},
  {"WINDOWS-1251", "be", true},
  {"ISO-8859-5", "ru", true},
  {"ISO-8859-5", "uk", true},
  {"IBM852", "pl", false},
  {"IBM852", "cs", false},
  {"IBM852", "hu", false},
  {"X-MAC-CYRILLIC", "ru", true},
  {"X-MAC-CYRILLIC", "uk", true},
]

KIND_OTHER = 0_u8
KIND_LOWER = 1_u8
KIND_UPPER = 2_u8
KIND_JUNK  = 3_u8

struct ModelSpec
  getter name : String
  getter language : String?
  getter alphabet : String
  getter matrix : Array(Int32)
  getter index : Hash(Char, UInt8)

  def initialize(@name : String, @language : String?, @alphabet : String, @matrix : Array(Int32))
    abort "#{@name}: alphabet has #{@alphabet.size} letters, max 63" if @alphabet.size > 63
    abort "#{@name}: matrix has #{@matrix.size} cells, expected 4096" unless @matrix.size == 4096
    @index = {} of Char => UInt8
    @alphabet.each_char_with_index do |ch, i|
      @index[ch] = (i + 1).to_u8
    end
  end
end

def load_model(name : String, language : String?) : ModelSpec
  path = File.join(MODELS_DIR, "#{name}.json")
  abort "missing model #{path}; run tools/train_models.cr --fetch first" unless File.exists?(path)
  data = JSON.parse(File.read(path))
  ModelSpec.new(
    data["name"].as_s,
    language,
    data["alphabet"].as_s,
    data["matrix"].as_a.map(&.as_i),
  )
end

def byte_entry(byte : Int32, char : Char, model : ModelSpec, requires_high_letters : Bool) : UInt8
  if byte < 0x80
    if (byte < 0x20 && ![0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x1B].includes?(byte)) || byte == 0x7F
      return KIND_JUNK << 6
    end
    if !requires_high_letters
      if order = model.index[char.downcase]?
        kind = char.uppercase? ? KIND_UPPER : KIND_LOWER
        return (kind << 6) | order
      end
    end
    return KIND_OTHER << 6
  end

  if char == '\u{FFFD}' || char.ord < 0xA0 || (0x2500..0x259F).includes?(char.ord)
    return KIND_JUNK << 6
  end

  if order = model.index[char.downcase]?
    kind = char.uppercase? ? KIND_UPPER : KIND_LOWER
    return (kind << 6) | order
  end

  # High letters outside the model's alphabet are penalized as Junk.
  if char.letter?
    return KIND_JUNK << 6
  end

  KIND_OTHER << 6
end

def emit_bytes_literal(bytes : Indexable, indent : String, per_line : Int32 = 32)
  chunks = [] of String
  bytes.each_slice(per_line) do |slice|
    hex = String.build do |io|
      slice.each do |b|
        v = b.to_i32 & 0xFF
        io << "\\x" << v.to_s(16).rjust(2, '0')
      end
    end
    chunks << hex
  end
  chunks.each_with_index do |chunk, idx|
    suffix = idx + 1 < chunks.size ? " \\" : ".to_slice"
    puts "#{indent}\"#{chunk}\"#{suffix}"
  end
end

models = {} of String => ModelSpec
PROBER_SPECS.map(&.[1]).uniq!.each do |name|
  lang = name == "western" ? nil : name
  models[name] = load_model(name, lang)
end

puts "# Generated by tools/gen_tables.cr. Do not edit."
puts "module Fathom"
puts "  module SingleByte"
puts "    private MODELS = {"
models.each_value do |m|
  puts "      #{m.name.inspect} => LanguageModel.new("
  puts "        #{m.name.inspect},"
  puts "        load_bigrams("
  emit_bytes_literal(m.matrix, "          ")
  puts "        ),"
  puts "        #{m.language.inspect},"
  puts "      ),"
end
puts "    }"
puts
puts "    # Precomputed single-byte bigram probers (WINDOWS-1252 first to break ties on shared bytes)."
puts "    PROBERS = ["

PROBER_SPECS.each do |enc, model_name, requires_high_letters|
  m = models[model_name]
  iconv_enc = Fathom::Encoding.iconv_name(enc)
  entries = (0..255).map do |b|
    char = if b < 0x80
             b.chr
           else
             String.new(Bytes[b.to_u8], iconv_enc, invalid: :skip)[0]? || '\u{FFFD}'
           end
    byte_entry(b, char, m, requires_high_letters)
  end

  puts "      Table.new("
  puts "        #{enc.inspect},"
  puts "        MODELS[#{model_name.inspect}],"
  puts "        #{requires_high_letters},"
  puts "        load_byte_map("
  emit_bytes_literal(entries, "          ")
  puts "        ),"
  puts "      ),"
end

puts "    ] of Fathom::Prober"
puts "  end"
puts "end"
