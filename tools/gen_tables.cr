# Regenerates src/fathom/tables.cr from the system iconv:
#   crystal run tools/gen_tables.cr > src/fathom/tables.cr
# iconv is needed only here; the shard itself decodes nothing through it.

require "../src/fathom/encoding"

ENCODINGS = [
  {"WINDOWS-1252", "AccentedLatin"},
  {"WINDOWS-1251", "Frequency"},
  {"KOI8-R", "Frequency"},
  {"KOI8-U", "Frequency"},
  {"ISO-8859-5", "Frequency"},
  {"IBM866", "Frequency"},
]

# Letter frequency in percent for Russian, with Ukrainian and Belarusian extras.
# TODO: replace unigram table with bigram models trained from a corpus for short inputs.
CYRILLIC_FREQ = {
  'о' => 10.97, 'е' => 8.45, 'а' => 8.01, 'и' => 7.35, 'н' => 6.70, 'т' => 6.26,
  'с' => 5.47, 'р' => 4.73, 'в' => 4.54, 'л' => 4.40, 'к' => 3.49, 'м' => 3.21,
  'д' => 2.98, 'п' => 2.81, 'у' => 2.62, 'я' => 2.01, 'ы' => 1.90, 'ь' => 1.74,
  'г' => 1.70, 'з' => 1.65, 'б' => 1.59, 'ч' => 1.44, 'й' => 1.21, 'х' => 0.97,
  'ж' => 0.94, 'ш' => 0.73, 'ю' => 0.64, 'ц' => 0.48, 'щ' => 0.36, 'э' => 0.32,
  'ф' => 0.26, 'ъ' => 0.04, 'ё' => 0.04,
  'і' => 5.0, 'ї' => 0.7, 'є' => 0.6, 'ґ' => 0.01, 'ў' => 1.0,
}

CHAR_CLASS_JUNK  = 0_u8
CHAR_CLASS_OTHER = 1_u8
CHAR_CLASS_LOWER = 2_u8
CHAR_CLASS_UPPER = 3_u8

def classify(char : Char) : UInt8
  if char == '\u{FFFD}' || char.ord < 0xA0 || (0x2500..0x259F).includes?(char.ord)
    CHAR_CLASS_JUNK
  elsif char.letter?
    char.uppercase? ? CHAR_CLASS_UPPER : CHAR_CLASS_LOWER
  else
    CHAR_CLASS_OTHER
  end
end

def weight_for(char : Char, cls : UInt8, mode : String) : Int16
  return -1000_i16 if cls == CHAR_CLASS_JUNK
  return 0_i16 if cls == CHAR_CLASS_OTHER

  if mode == "Frequency"
    freq = CYRILLIC_FREQ[char.downcase]? || -5.0
    (freq * 100.0).round.to_i16
  else
    200_i16
  end
end

puts "# Generated by tools/gen_tables.cr. Do not edit."
puts "module Fathom"
puts "  module SingleByte"
puts "    # Precomputed single-byte probers (WINDOWS-1252 first to break ties on shared punctuation)."
puts "    PROBERS = ["

ENCODINGS.each do |enc, mode|
  classes = [] of UInt8
  weights = [] of Int16

  iconv_enc = Fathom::Encoding.iconv_name(enc)
  (0x80..0xFF).each do |b|
    char = String.new(Bytes[b.to_u8], iconv_enc, invalid: :skip)[0]? || '\u{FFFD}'
    cls = classify(char)
    classes << cls
    weights << weight_for(char, cls, mode)
  end

  puts "      Table.new("
  puts "        #{enc.inspect},"
  puts "        Mode::#{mode},"
  puts "        StaticArray["
  classes.each_slice(16) do |slice|
    puts "          #{slice.map { |v| "#{v}_u8" }.join(", ")},"
  end
  puts "        ],"
  puts "        StaticArray["
  weights.each_slice(16) do |slice|
    puts "          #{slice.map { |v| "#{v}_i16" }.join(", ")},"
  end
  puts "        ],"
  puts "      ),"
end

puts "    ] of Fathom::Prober"
puts "  end"
puts "end"
