# Generates src/fathom/whatwg/indexes.cr from the WHATWG Encoding Standard indexes.
#
#   crystal run tools/gen_whatwg_indexes.cr
#
# Downloads https://encoding.spec.whatwg.org/indexes.json into tools/whatwg_data/
# (git-ignored) and checks it against INDEXES_SHA256. The standard is a living
# document: when the file changes, review the diff of the generated tables and
# update the hash.
#
# The indexes are copyright WHATWG; incorporated into source code they are
# licensed under the BSD 3-Clause License (LICENSE-whatwg), whose text the
# generated file carries.
require "http/client"
require "json"
require "digest/sha256"

INDEXES_URL    = "https://encoding.spec.whatwg.org/indexes.json"
INDEXES_SHA256 = "b7c8961095f0b4cae8f4a16a5011e7c84047a60c1277e28ee8df9e56074ee509"
CACHE          = File.expand_path("whatwg_data", __DIR__)
LICENSE        = File.expand_path("../LICENSE-whatwg", __DIR__)
OUT            = File.expand_path("../src/fathom/whatwg/indexes.cr", __DIR__)

# Big5 pointers below this are all unmapped; the table starts here.
BIG5_FIRST_POINTER = 942

def indexes_json : String
  path = File.join(CACHE, "indexes.json")
  unless File.exists?(path)
    Dir.mkdir_p(CACHE)
    STDERR.puts "fetching #{INDEXES_URL}"
    HTTP::Client.get(INDEXES_URL) do |res|
      abort "#{INDEXES_URL}: HTTP #{res.status_code}" unless res.success?
      File.open(path, "wb") { |f| IO.copy(res.body_io, f) }
    end
  end
  actual = Digest::SHA256.new.file(path).hexfinal
  abort "indexes.json SHA-256 is #{actual}, expected #{INDEXES_SHA256}; review the upstream change and update INDEXES_SHA256" unless actual == INDEXES_SHA256
  File.read(path)
end

# Code points of a pointer index, `0` for pointers without a mapping.
def code_points(json : JSON::Any, name : String) : Array(Int32)
  json[name].as_a.map { |v| v.raw.nil? ? 0 : v.as_i }
end

def u16le(values : Array(Int32)) : Bytes
  Bytes.new(values.size * 2) do |i|
    v = values[i // 2]
    abort "value #{v} does not fit 16 bits" if v > 0xFFFF
    (i.even? ? v & 0xFF : v >> 8).to_u8
  end
end

def emit(io : IO, name : String, doc : String, bytes : Bytes) : Nil
  io << "    # " << doc << "\n"
  io << "    # :nodoc:\n"
  io << "    " << name << " = (\n"
  rows = bytes.each_slice(32).to_a
  rows.each_with_index do |row, i|
    io << "      \""
    row.each { |b| io << "\\x" << b.to_s(16).rjust(2, '0') }
    io << '"' << (i == rows.size - 1 ? "" : " \\") << '\n'
  end
  io << "    ).to_slice # #{bytes.size} bytes\n"
end

json = JSON.parse(indexes_json)

big5 = code_points(json, "big5")
abort "big5 pointers below #{BIG5_FIRST_POINTER} are expected to be unmapped" if big5[0, BIG5_FIRST_POINTER].any?(&.!=(0))
big5 = big5[BIG5_FIRST_POINTER..]
big5.each { |cp| abort "big5 code point #{cp.to_s(16)} is outside planes 0 and 2" unless cp <= 0xFFFF || cp >> 16 == 2 }
big5_low = big5.map { |cp| cp & 0xFFFF }
big5_astral = Bytes.new((big5.size + 7) // 8)
big5.each_with_index { |cp, i| big5_astral[i // 8] |= (1_u8 << (i % 8)) if cp > 0xFFFF }

ranges = json["gb18030-ranges"].as_a.map { |pair| {pair[0].as_i, pair[1].as_i} }
ranges_bytes = Bytes.new(ranges.size * 8)
ranges.each_with_index do |(pointer, cp), i|
  4.times do |k|
    ranges_bytes[i * 8 + k] = (pointer >> (8 * k)).to_u8!
    ranges_bytes[i * 8 + 4 + k] = (cp >> (8 * k)).to_u8!
  end
end

code = String.build do |io|
  io << "# Generated by tools/gen_whatwg_indexes.cr from the WHATWG Encoding Standard\n"
  io << "# indexes (#{INDEXES_URL}, SHA-256 #{INDEXES_SHA256}). Do not edit.\n#\n"
  File.read(LICENSE).each_line { |line| io << (line.empty? ? "#" : "# #{line}") << '\n' }
  io << "module Fathom\n  module WHATWG\n"
  io << "    # Pointer tables hold little-endian UInt16 code points; 0 marks a pointer without a mapping.\n\n"
  emit(io, "JIS0208", "index jis0208 (#{code_points(json, "jis0208").size} pointers).", u16le(code_points(json, "jis0208")))
  io << '\n'
  emit(io, "JIS0212", "index jis0212 (#{code_points(json, "jis0212").size} pointers).", u16le(code_points(json, "jis0212")))
  io << '\n'
  emit(io, "ISO_2022_JP_KATAKANA", "index ISO-2022-JP katakana (63 pointers).", u16le(code_points(json, "iso-2022-jp-katakana")))
  io << '\n'
  emit(io, "EUC_KR", "index EUC-KR (#{code_points(json, "euc-kr").size} pointers).", u16le(code_points(json, "euc-kr")))
  io << '\n'
  emit(io, "GB18030", "index gb18030 (#{code_points(json, "gb18030").size} pointers).", u16le(code_points(json, "gb18030")))
  io << '\n'
  emit(io, "GB18030_RANGES", "index gb18030 ranges: #{ranges.size} little-endian {UInt32 pointer, UInt32 code point} pairs.", ranges_bytes)
  io << '\n'
  emit(io, "BIG5_LOW", "index Big5 from pointer #{BIG5_FIRST_POINTER}: low 16 bits of each code point.", u16le(big5_low))
  io << '\n'
  emit(io, "BIG5_ASTRAL", "One bit per BIG5_LOW entry: set when the code point is in plane 2 (U+2xxxx).", big5_astral)
  io << "  end\nend\n"
end

File.write(OUT, code)
puts "wrote #{OUT}"
